{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Zeus-SDR/zeus-community-features/main/schema/registry.schema.json",
  "title": "Zeus community feature registry",
  "description": "Authoritative schema for registry.json. Repository policy additionally restricts outside submissions to channel=community, verified=false, and no subscription field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generated", "plugins"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Catalog schema revision consumed by SDK ABI 1."
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "UTC RFC 3339 timestamp for the latest catalog edit."
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/pluginEntry" }
    }
  },
  "$defs": {
    "reverseDnsId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$",
      "description": "Permanent lowercase reverse-DNS feature ID."
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"
    },
    "strictSemver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "name",
        "description",
        "author",
        "license",
        "homepage",
        "categories",
        "verified",
        "versions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/reverseDnsId" },
        "channel": {
          "type": "string",
          "enum": ["official", "community"],
          "description": "Features UI lane. Outside submissions must use community."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "author": { "type": "string", "minLength": 1, "maxLength": 160 },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "verified": {
          "type": "boolean",
          "description": "Maintainer-controlled metadata. Outside submissions must use false."
        },
        "subscription": {
          "$ref": "#/$defs/subscription",
          "description": "Official catalog compatibility field; forbidden in community submissions."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pluginVersion" }
        }
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "monthlyPriceCents", "currency"],
      "properties": {
        "required": { "type": "boolean" },
        "monthlyPriceCents": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "checkoutUrl": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https://"
        },
        "notes": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "pluginVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sdkAbi", "sdkMinVersion", "platforms", "downloadUrl", "sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "sdkAbi": { "type": "integer", "minimum": 1 },
        "sdkMinVersion": { "$ref": "#/$defs/strictSemver" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["any", "linux-x64", "linux-arm64", "win-x64", "win-arm64", "osx-x64", "osx-arm64"]
          }
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Immutable HTTPS ZIP URL. Repository policy requires community versions to use their exact deterministic Zeus-SDR custody release URL."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase SHA-256 of the exact release ZIP."
        },
        "source": { "$ref": "#/$defs/versionSource" }
      }
    },
    "versionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "package"],
      "description": "Public source provenance for one release. Repository policy requires it on every community version added after the package security scan was introduced; older versions are grandfathered and official versions are exempt. Zeus ignores this field.",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "not": { "pattern": "\\.git$" },
          "description": "Public GitHub source repository, without a trailing .git or slash."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full lowercase commit SHA the package was built from."
        },
        "package": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/?#%]+/[^/?#%]+\\.zip$",
          "description": "Contributor intake GitHub Releases ZIP whose bytes match sha256."
        }
      }
    }
  }
}
